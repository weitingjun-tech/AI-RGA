# RAG 知识库问答系统 - 环境变量配置
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_knowledge_base

# 运行环境：development / production
# production 下会强制校验 JWT_SECRET、关闭 /docs、隐藏异常细节
APP_ENV=development

# JWT
# 必填，至少 32 字符。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空或使用占位值时，开发环境会自动生成随机密钥（重启后需重新登录），
# 生产环境则直接拒绝启动——默认密钥等于把管理员令牌的签发权公开。
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# 登录失败锁定
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
HF_HOME=D:/mydo/huggingface_cache

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=ecommerce_knowledge

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.3

# 检索质量
# 混合检索：向量（语义泛化）+ BM25（精确匹配），RRF 融合。
# 专治型号 / 错误码 / 专有名词类查询——纯向量对这类内容几乎无感。
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_K=20
RRF_K=60
# 去冗余：移除与已选片段高度重复的候选，避免 Top-K 被近似内容占满
DEDUP_ENABLED=true
DEDUP_JACCARD_THRESHOLD=0.8
# 精排（Cross-Encoder）。
#
# **默认关闭的原因是延迟，不是因为没效果。**
#
# 拿它当"排序"手段：没有收益，甚至更差
#   MRR 0.758 → 0.744，多跳问题 1.000 → 0.833。延迟 34ms → 8953ms（CPU 上约 260 倍）。
#
# 拿它做"拒答判定"：效果显著
#   向量分数分不开"知识库里有没有答案"（无答案 0.53 vs 有答案 0.59，几乎重叠），
#   精排分数则差 4~5 倍（0.19 vs 0.87）。
#   净效果：拒答 0/5 → 4/5，误伤 1 道正常题，合计 Hit@5 83.3% → 93.3%。
#
# 有 GPU 的话延迟会降到 1 秒以内，那时建议默认打开。
# 换机器后请先用 `cd eval && python run_eval.py` 重新量一遍再决定。
#
# 模型约 1.1GB，首次使用前需要下载：
#   python -c "from huggingface_hub import snapshot_download; snapshot_download('BAAI/bge-reranker-base')"
# 模型不可用时会自动跳过精排（退回融合排序），不会导致检索失败。
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
# 精排拒答阈值：低于此分数的候选视为"不对口"，直接清空走拒答。
# 只决定"这条要不要"，不参与排序先后。0 = 关闭该行为。
# 实测 35 条样本上的可用区间是 (0.089, 0.478)，0.35 取其中间。
# 调低 → 更少误伤正常问题，但拒答变弱；调高 → 反之。两边都要用上面那条命令复测。
RERANK_REFUSAL_THRESHOLD=0.35
# 多轮检索改写（指代消解）：把「它支持哪些数据库」这类追问改写成可独立检索的问题。
# 只在问题确实依赖上文时才触发，不会给每轮都加一次 LLM 调用。
QUERY_REWRITE_ENABLED=true
# 是否记录每次检索的明细（用于 bad case 归因与效果分析）
RETRIEVAL_LOG_ENABLED=true

# 缓存
CACHE_TTL=300
CACHE_MAX_SIZE=128

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志
# LOG_FORMAT=json 会输出单行 JSON，便于日志采集系统（ELK/Loki）解析
LOG_LEVEL=INFO
LOG_FORMAT=text

# 任务队列（Celery + Redis）
REDIS_URL=redis://localhost:6379/0
# auto   = 探测 broker，可用走 Celery，否则降级本地线程（开发方便，但会丢任务）
# celery = 强制 Celery，broker 不可用直接报错（**生产必须用这个**）
# thread = 强制本地线程（仅纯本地开发）
TASK_QUEUE_MODE=auto
DOC_TASK_MAX_RETRIES=3
DOC_TASK_RETRY_DELAY=30
DOC_TASK_TIMEOUT_SECONDS=1800

# 启动行为
# 多副本生产环境必须把 RUN_MIGRATIONS_ON_STARTUP 设为 false，
# 改由发布流水线执行 `alembic upgrade head`，避免多副本并发跑同一批 DDL
RUN_MIGRATIONS_ON_STARTUP=true
RECONCILE_ON_STARTUP=true

# 接口限流（格式：次数/周期，周期可选 second/minute/hour/day）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=60/hour

# 权限（ACL）
# true  = 普通用户只能检索被显式授权的知识库（企业默认，最小权限）
# false = 所有登录用户可访问全部知识库（仅适合单人开发调试）
KB_ACL_ENABLED=true

# 审计日志
AUDIT_LOG_ENABLED=true