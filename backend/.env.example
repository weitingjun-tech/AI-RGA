# RAG 知识库问答系统 - 环境变量配置
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=rag_knowledge_base

# 运行环境：development / production
# production 下会强制校验 JWT_SECRET、关闭 /docs、隐藏异常细节
APP_ENV=development

# JWT
# 必填，至少 32 字符。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空或使用占位值时，开发环境会自动生成随机密钥（重启后需重新登录），
# 生产环境则直接拒绝启动——默认密钥等于把管理员令牌的签发权公开。
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# 登录失败锁定
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
HF_HOME=D:/mydo/huggingface_cache

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=ecommerce_knowledge

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.3

# 缓存
CACHE_TTL=300
CACHE_MAX_SIZE=128

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志
# LOG_FORMAT=json 会输出单行 JSON，便于日志采集系统（ELK/Loki）解析
LOG_LEVEL=INFO
LOG_FORMAT=text

# 任务队列（Celery + Redis）
REDIS_URL=redis://localhost:6379/0
# auto   = 探测 broker，可用走 Celery，否则降级本地线程（开发方便，但会丢任务）
# celery = 强制 Celery，broker 不可用直接报错（**生产必须用这个**）
# thread = 强制本地线程（仅纯本地开发）
TASK_QUEUE_MODE=auto
DOC_TASK_MAX_RETRIES=3
DOC_TASK_RETRY_DELAY=30
DOC_TASK_TIMEOUT_SECONDS=1800

# 启动行为
# 多副本生产环境必须把 RUN_MIGRATIONS_ON_STARTUP 设为 false，
# 改由发布流水线执行 `alembic upgrade head`，避免多副本并发跑同一批 DDL
RUN_MIGRATIONS_ON_STARTUP=true
RECONCILE_ON_STARTUP=true

# 接口限流（格式：次数/周期，周期可选 second/minute/hour/day）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=60/hour

# 权限（ACL）
# true  = 普通用户只能检索被显式授权的知识库（企业默认，最小权限）
# false = 所有登录用户可访问全部知识库（仅适合单人开发调试）
KB_ACL_ENABLED=true

# 审计日志
AUDIT_LOG_ENABLED=true